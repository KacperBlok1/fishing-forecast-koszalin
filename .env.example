# ============================================================
# Konfiguracja aplikacji "Czy warto iść na ryby?"
# Skopiuj ten plik jako .env i uzupełnij dwa pierwsze sekrety.
#   cp .env.example .env
# ============================================================

# --- WYMAGANE -----------------------------------------------

# Hasło do bazy danych. Dowolny długi ciąg — wygeneruj np. tak:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Sekret do podpisywania tokenów sesji. Wygeneruj np. tak:
#   openssl rand -base64 48
# Zmiana tej wartości wylogowuje wszystkich ze wszystkich urządzeń,
# ale NIE kasuje żadnych danych.
SESSION_SECRET=

# --- OPCJONALNE ---------------------------------------------

# Port na hoście. Wewnątrz kontenera aplikacja zawsze słucha na 8090.
APP_PORT=8090

# Nazwa bazy i użytkownika bazy.
POSTGRES_DB=fishing
POSTGRES_USER=fishing

# Ustaw na false, gdy założysz już swoje konta — wtedy nikt obcy
# nie zarejestruje się nawet po wejściu na adres aplikacji.
ALLOW_REGISTRATION=true

# Ustaw na true DOPIERO gdy aplikacja stoi za HTTPS.
# Przy zwykłym http:// ciasteczko z sesją nie dojdzie i nie zalogujesz się.
COOKIE_SECURE=false

# Jak długo odpowiedź Open-Meteo jest uznawana za świeżą (minuty).
WEATHER_FRESH_MINUTES=15

# Jak długo trzymać starą odpowiedź jako awaryjną, gdy Open-Meteo nie działa (godziny).
WEATHER_STALE_HOURS=24

# Po ilu dniach wygasa sesja (trzeba się zalogować ponownie).
SESSION_DAYS=90

# Poziom logów: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
